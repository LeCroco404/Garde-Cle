# En-têtes de sécurité HTTP, appliqués par Netlify à toutes les pages.
# Ce fichier n'est pas publié : Netlify le lit au déploiement.

/*
  # Même politique que la balise <meta> des pages, plus frame-ancestors,
  # qui ne fonctionne qu'en en-tête : interdit d'afficher le site dans un
  # cadre (iframe) sur un autre site, ce qui bloque le "clickjacking".
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  # Le navigateur ne devine pas le type d'un fichier : il suit celui annoncé.
  X-Content-Type-Options: nosniff
  # N'envoie pas l'adresse de la page aux sites des sources.
  Referrer-Policy: no-referrer
  # Le site n'a besoin ni de la caméra, ni du micro, ni de la localisation.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Force HTTPS pendant un an pour les prochaines visites.
  Strict-Transport-Security: max-age=31536000
  # Isole l'onglet des fenêtres ouvertes par d'autres sites.
  Cross-Origin-Opener-Policy: same-origin
